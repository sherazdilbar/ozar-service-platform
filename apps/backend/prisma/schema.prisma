// Prisma Schema for Ozar Backend
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  CUSTOMER
  PRO
  ADMIN
}

enum ServiceCategory {
  // 1. Home & Property Services - Repairs & Maintenance
  ELECTRICIAN
  PLUMBER
  HANDYMAN
  HVAC_AC_REPAIR
  APPLIANCE_REPAIR
  GAS_TECHNICIAN
  
  // 1. Home & Property Services - Renovation & Installation
  PAINTING
  FLOORING
  TILE_WORK
  KITCHEN_BATHROOM_REMODELING
  DOOR_WINDOW_INSTALLATION
  
  // 1. Home & Property Services - Outdoor & Property Care
  GARDENING_LAWN_MOWING
  TREE_TRIMMING
  FENCE_INSTALLATION
  PRESSURE_WASHING
  SNOW_REMOVAL
  
  // 2. Cleaning Services
  HOME_CLEANING
  DEEP_CLEANING
  OFFICE_CLEANING
  MOVE_IN_OUT_CLEANING
  CARPET_SOFA_CLEANING
  POST_CONSTRUCTION_CLEANING
  
  // 3. Beauty, Grooming & Wellness - Hair & Grooming
  HAIRCUT
  HAIRSTYLIST
  BARBER
  BEARD_GROOMING
  
  // 3. Beauty, Grooming & Wellness - Beauty Services
  MANICURE_PEDICURE
  MAKEUP_ARTIST
  NAIL_TECHNICIAN
  EYELASH_EYEBROW_SERVICES
  
  // 3. Beauty, Grooming & Wellness - Wellness
  MASSAGE_THERAPY
  PHYSIOTHERAPY
  YOGA_INSTRUCTOR
  PERSONAL_TRAINER
  
  // 4. Tech & Smart Home
  TV_MOUNTING
  WIFI_SETUP
  SMART_HOME_INSTALLATION
  CCTV_INSTALLATION
  COMPUTER_LAPTOP_REPAIR
  PRINTER_SETUP
  
  // 5. Moving & Logistics
  HOUSE_SHIFTING
  FURNITURE_MOVING
  SMALL_DELIVERIES
  PACKING_UNPACKING
  JUNK_REMOVAL
  
  // 6. Daily Help & Personal Assistance
  COOKING_HOME_CHEF
  MEAL_PREP
  BABYSITTING
  ELDERLY_CARE
  HOME_HELPER
  
  // 7. Pet Services
  DOG_WALKING
  PET_SITTING
  PET_GROOMING
  VET_VISIT_ASSISTANCE
  
  // 8. Events & Occasions
  PARTY_DECORATORS
  CATERERS
  DJS
  PHOTOGRAPHERS
  VIDEOGRAPHERS
  
  // 9. Learning & Education
  HOME_TUTORS
  MUSIC_TEACHERS
  LANGUAGE_TUTORS
  FITNESS_TRAINERS
  
  // 10. Quick Tasks (On-Demand)
  FURNITURE_ASSEMBLY
  MOUNTING_DRILLING
  SMALL_FIXES
  EMERGENCY_ELECTRICIAN
  EMERGENCY_PLUMBER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE_NOW
  AVAILABLE_SOON
  BUSY
  OFFLINE
}

enum PricingModel {
  HOURLY
  FIXED
  INSPECTION
}

enum BookingStatus {
  DRAFT
  REQUESTED
  OFFERED
  ACCEPTED
  PAYMENT_AUTHORIZED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CAPTURED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PRO
  NO_SHOW
  DISPUTED
  REFUNDED
}

// Models
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  firstName         String
  lastName          String
  phone             String
  avatar            String?
  bio               String?
  role              UserRole @default(CUSTOMER)
  preferredLanguage String   @default("en")
  
  // Email verification
  emailVerified     Boolean  @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  
  // Password reset
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Location fields
  locationCity     String?
  locationDistrict String?  // Budapest district (I-XXIII)
  locationArea     String?
  locationLat      Float?
  locationLng      Float?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  proProfile           ProProfile?
  customerBookings     Booking[]        @relation("CustomerBookings")
  reviews              Review[]
  refreshTokens        RefreshToken[]
  disputesRaised       Dispute[]        @relation("DisputesRaised")
  disputesResolved     Dispute[]        @relation("DisputesResolved")
  notifications        Notification[]
  customerConversations Conversation[]  @relation("CustomerConversations")
  sentMessages         Message[]        @relation("SentMessages")
  favorites            Favorite[]       @relation("CustomerFavorites")
  reviewHelpfulVotes   ReviewHelpfulVote[]
  jobs                 Job[]            @relation("CustomerJobs")

  @@index([email])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model ProProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String?
  bio                String?
  categories         ServiceCategory[]
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  jobsCompleted      Int                @default(0)
  yearsExperience    Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  availabilityStatus AvailabilityStatus @default(OFFLINE)
  startingPrice      Int                @default(0)
  currency           String             @default("USD")
  responseTime       Int                @default(30)
  serviceAreaCity    String
  serviceAreaDistricts String[]         // Budapest districts they serve (I-XXIII)
  serviceAreaRadius  Int                @default(10)
  locationCity       String
  locationDistrict   String?            // Their base district
  locationArea       String
  locationLat        Float
  locationLng        Float
  
  // Onboarding tracking
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        String?
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      Service[]
  portfolio     PortfolioItem[]
  reviews       Review[]
  bookings      Booking[]
  conversations Conversation[]
  favoritedBy   Favorite[]     @relation("ProFavorites")
  certifications Certification[]
  badges        Badge[]
  bids          Bid[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([locationLat, locationLng])
  @@map("pro_profiles")
}

model Service {
  id           String        @id @default(cuid())
  proId        String
  name         String
  description  String
  category     ServiceCategory
  pricingModel PricingModel
  price        Int
  duration     Int
  currency     String        @default("USD")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  pro      ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([proId, name])
  @@index([proId])
  @@index([category])
  @@map("services")
}

model PortfolioItem {
  id          String          @id @default(cuid())
  proId       String
  imageUrl    String
  title       String
  description String
  category    ServiceCategory
  createdAt   DateTime        @default(now())

  // Relations
  pro ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@map("portfolio_items")
}

model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  proId              String
  serviceId          String
  status             BookingStatus @default(REQUESTED)
  scheduledFor       DateTime?
  isASAP             Boolean       @default(false)
  description        String
  customerNotes      String?
  images             String[]
  locationAddr       String
  locationCity       String
  locationLat        Float
  locationLng        Float
  servicePrice       Int
  platformFee        Int
  total              Int
  currency           String        @default("USD")
  completedAt        DateTime?
  
  // Cancellation fields
  cancellationReason String?
  cancelledBy        String?
  cancellationFee    Int?
  refundAmount       Int?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id])
  pro           ProProfile     @relation(fields: [proId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  events        BookingEvent[]
  review        Review?
  disputes      Dispute[]
  conversations Conversation[]

  @@index([customerId])
  @@index([proId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingEvent {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  note      String?
  createdAt DateTime      @default(now())

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_events")
}

model Review {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  proId            String
  customerId       String
  rating           Int
  comment          String
  images           String[] @default([])
  responseText     String?
  responseAt       DateTime?
  helpfulCount     Int      @default(0)
  createdAt        DateTime @default(now())

  // Relations
  booking  Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pro      ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  customer User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpfulVote[]

  @@index([proId])
  @@index([customerId])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_helpful_votes")
}

// Dispute Management
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String
  raisedBy    String
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedByUser User    @relation("DisputesRaised", fields: [raisedBy], references: [id])
  resolver     User?   @relation("DisputesResolved", fields: [resolvedBy], references: [id])

  @@index([bookingId])
  @@index([raisedBy])
  @@index([status])
  @@map("disputes")
}

// Notifications
enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_DECLINED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  DISPUTE_CREATED
  DISPUTE_RESOLVED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// Chat System
model Conversation {
  id         String    @id @default(cuid())
  customerId String
  proId      String
  bookingId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  customer User       @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  pro      ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  booking  Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([customerId, proId, bookingId])
  @@index([customerId])
  @@index([proId])
  @@index([bookingId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  imageUrl       String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// Favorites
model Favorite {
  id         String   @id @default(cuid())
  customerId String
  proId      String
  createdAt  DateTime @default(now())

  // Relations
  customer User       @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  pro      ProProfile @relation("ProFavorites", fields: [proId], references: [id], onDelete: Cascade)

  @@unique([customerId, proId])
  @@index([customerId])
  @@index([proId])
  @@map("favorites")
}

// Availability Schedule
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AvailabilitySchedule {
  id        String    @id @default(cuid())
  proId     String
  dayOfWeek DayOfWeek
  startTime String    // Format: "HH:mm"
  endTime   String    // Format: "HH:mm"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([proId])
  @@index([dayOfWeek])
  @@map("availability_schedules")
}

model TimeOff {
  id        String   @id @default(cuid())
  proId     String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([proId])
  @@index([startDate, endDate])
  @@map("time_offs")
}

// Certifications & Badges
enum CertificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model Certification {
  id             String              @id @default(cuid())
  proId          String
  name           String
  issuingOrg     String
  issueDate      DateTime
  expiryDate     DateTime?
  certificateUrl String?
  status         CertificationStatus @default(PENDING)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  pro ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@index([status])
  @@map("certifications")
}

model Badge {
  id          String   @id @default(cuid())
  proId       String
  badgeType   String   // e.g., "VERIFIED", "TOP_RATED", "QUICK_RESPONDER"
  name        String
  description String
  icon        String
  earnedAt    DateTime @default(now())

  // Relations
  pro ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)

  @@index([proId])
  @@map("badges")
}

// Automated Responses & Templates
model ResponseTemplate {
  id        String   @id @default(cuid())
  proId     String
  name      String
  content   String
  category  String   // e.g., "GREETING", "CONFIRMATION", "FOLLOW_UP"
  isActive  Boolean  @default(true)
  usageCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proId])
  @@index([category])
  @@map("response_templates")
}

model AutoResponse {
  id        String   @id @default(cuid())
  proId     String
  trigger   String   // e.g., "NEW_BOOKING", "AFTER_HOURS"
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proId])
  @@map("auto_responses")
}

// Service Area Management
model ServiceArea {
  id          String   @id @default(cuid())
  proId       String
  city        String
  area        String?
  radius      Int      // in kilometers
  travelFee   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([proId])
  @@map("service_areas")
}

// Marketing & Referrals
model ReferralCode {
  id            String   @id @default(cuid())
  proId         String
  code          String   @unique
  discountType  String   // "PERCENTAGE" or "FIXED"
  discountValue Int
  maxUses       Int?
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([proId])
  @@index([code])
  @@map("referral_codes")
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String   // Pro who referred
  referredId   String   // Customer who was referred
  code         String
  bookingId    String?
  rewardAmount Int      @default(0)
  status       String   @default("PENDING") // PENDING, COMPLETED, PAID
  createdAt    DateTime @default(now())

  @@index([referrerId])
  @@index([referredId])
  @@index([code])
  @@map("referrals")
}

// Quick Actions & Booking Enhancements
model QuickMessage {
  id        String   @id @default(cuid())
  proId     String
  message   String
  category  String   // e.g., "ON_MY_WAY", "RUNNING_LATE", "COMPLETED"
  usageCount Int     @default(0)
  createdAt DateTime @default(now())

  @@index([proId])
  @@map("quick_messages")
}

model BookingPhoto {
  id        String   @id @default(cuid())
  bookingId String
  imageUrl  String
  caption   String?
  type      String   // "BEFORE", "DURING", "AFTER"
  uploadedBy String
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_photos")
}

// Job Posting & Bidding System
enum JobStatus {
  OPEN
  BIDDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum JobUrgency {
  ASAP
  THIS_WEEK
  FLEXIBLE
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Job {
  id          String          @id @default(cuid())
  customerId  String
  title       String
  description String
  category    ServiceCategory
  urgency     JobUrgency      @default(FLEXIBLE)
  status      JobStatus       @default(OPEN)
  
  // Location
  locationAddr String
  locationCity String
  locationArea String?
  locationLat  Float
  locationLng  Float
  
  // Budget
  budgetMin   Int?
  budgetMax   Int?
  currency    String          @default("HUF")
  
  // Media
  images      String[]        @default([])
  
  // Scheduling
  preferredDate DateTime?
  
  // Limits
  maxBids     Int             @default(10)
  expiresAt   DateTime?
  
  // Accepted bid
  acceptedBidId String?       @unique
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  customer    User            @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Cascade)
  bids        Bid[]
  acceptedBid Bid?            @relation("AcceptedBid", fields: [acceptedBidId], references: [id])

  @@index([customerId])
  @@index([category])
  @@index([status])
  @@index([locationLat, locationLng])
  @@index([createdAt])
  @@map("jobs")
}

model Bid {
  id          String    @id @default(cuid())
  jobId       String
  proId       String
  status      BidStatus @default(PENDING)
  
  // Offer details
  proposedPrice Int
  currency      String    @default("HUF")
  estimatedDuration Int   // in minutes
  message       String
  
  // Availability
  availableFrom DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pro         ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  acceptedJob Job?      @relation("AcceptedBid")

  @@unique([jobId, proId])
  @@index([jobId])
  @@index([proId])
  @@index([status])
  @@map("bids")
}

